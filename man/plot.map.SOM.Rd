# Plot cluster assignments on map
plot.map.SOM(
  SOM.output = som_clustered,
  Coordinates = coordinates
)

# Use custom cluster names and save map
plot.map.SOM(
  SOM.output = som_clustered,
  Coordinates = coordinates,
  legend.cluster.names = c("Cluster 1", "Cluster 2", "Cluster 3"),
  save = TRUE,
  plot.type = "svg",
  file.name = "SOM_map_plot.svg"
)
